# Normalize line endings for text files; default to LF unless overridden below.
* text=auto eol=lf

# Bash scripts must keep LF endings, or the shebang line breaks on Linux/macOS.
*.sh text eol=lf

# PowerShell scripts check out with native CRLF on Windows.
*.ps1 text eol=crlf

# Packaged skill archives are binary; never line-ending-normalize them.
*.zip binary
*.skill binary
*.7z binary
